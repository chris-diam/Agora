# Optional — the "Sign in with Google" button hides itself with a plain
# message until this is set. Must match the backend's GOOGLE_CLIENT_ID
# exactly (same Google Cloud OAuth Client ID, used by both sides).
VITE_GOOGLE_CLIENT_ID=

# Required in production (deployed as a static build with no dev proxy).
# Leave unset for local dev — Vite's proxy forwards relative "/api" calls to
# the local backend (see vite.config.ts). Example: https://api.example.com/api
VITE_API_URL=
