# Keycloak realm this app authenticates against. Local dev: the
# docker-compose "keycloak" service, realm "kyma", client "kyma-web" (see
# ../keycloak/kyma-realm.json). Production: the Render Keycloak service's
# URL. See DEPLOYMENT.md.
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=kyma
VITE_KEYCLOAK_CLIENT_ID=kyma-web

# Required in production (deployed as a static build with no dev proxy).
# Leave unset for local dev — Vite's proxy forwards relative "/api" calls to
# the local backend (see vite.config.ts). Example: https://api.example.com/api
VITE_API_URL=
