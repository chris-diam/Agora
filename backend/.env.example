DATABASE_URL="postgresql://social_platform:social_platform@localhost:5432/social_platform?schema=public"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"
PORT=4000
NODE_ENV=development

# Optional — Google sign-in returns a clear "not configured" error until
# this is set. See README for how to obtain one (Google Cloud Console ->
# APIs & Services -> Credentials -> OAuth client ID, type "Web application").
# Must match the frontend's VITE_GOOGLE_CLIENT_ID exactly.
GOOGLE_CLIENT_ID=

# Optional — restricts CORS to this exact origin. Leave unset for local dev.
# In production, set to the deployed frontend's origin, e.g.:
# CORS_ORIGIN=https://myapp.pages.dev
CORS_ORIGIN=
