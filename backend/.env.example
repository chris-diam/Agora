DATABASE_URL="postgresql://social_platform:social_platform@localhost:5432/social_platform?schema=public"

# Keycloak realm this API verifies access tokens against (JWKS at
# <KEYCLOAK_URL>/realms/<KEYCLOAK_REALM>/protocol/openid-connect/certs).
# Local dev: the docker-compose "keycloak" service, realm "kyma", client
# "kyma-web" (see keycloak/kyma-realm.json). Production: the Render
# Keycloak service's URL. See DEPLOYMENT.md.
KEYCLOAK_URL="http://localhost:8080"
KEYCLOAK_REALM="kyma"
KEYCLOAK_CLIENT_ID="kyma-web"

PORT=4000
NODE_ENV=development

# Optional — restricts CORS to this exact origin. Leave unset for local dev.
# In production, set to the deployed frontend's origin, e.g.:
# CORS_ORIGIN=https://myapp.pages.dev
CORS_ORIGIN=
